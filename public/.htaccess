# ASI OTT - Apache Rewrite & Optimization Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Rewrite /watch to /watch.html with query parameters preserved
  RewriteRule ^watch/?$ watch.html [L,QSA]
</IfModule>

# MIME Types for Video Streaming & Subtitles
<IfModule mod_mime.c>
  AddType application/vnd.apple.mpegurl .m3u8
  AddType video/mp2t .ts
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType text/vtt .vtt
</IfModule>

# Prevent Stale Cache on Code Updates
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Image Caching Configuration
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
